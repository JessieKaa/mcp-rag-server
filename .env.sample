# ============================================================
# PostgreSQL 连接信息
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ragdb

# ============================================================
# 文档目录
# ============================================================
SOURCE_DIR=./data/source
PROCESSED_DIR=./data/processed

# ============================================================
# 嵌入模型设置
# ============================================================

# 提供者选择：local（默认）或 openai
# - local  : 使用 sentence-transformers 进行本地推理（无需额外安装）
# - openai : OpenAI 兼容 API（需要：uv sync --extra openai）
EMBEDDING_PROVIDER=local

# 模型名称（env 的值优先于 EmbeddingGenerator 的参数）
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# 向量维度数（请根据模型的输出维度设置）
# 更改模型后请执行 `python -m src.cli clear && python -m src.cli index`
EMBEDDING_DIM=1024

# 前缀（对 E5 系列、Ruri 系列等专用模型有效。OpenAI 模型通常留空即可）
EMBEDDING_PREFIX_QUERY="query: "
EMBEDDING_PREFIX_EMBEDDING="passage: "

# ------------------------------------------------------------
# 本地模型设置示例
# ------------------------------------------------------------

# intfloat/multilingual-e5-large（默认、多语言支持）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DIM=1024
# EMBEDDING_PREFIX_QUERY="query: "
# EMBEDDING_PREFIX_EMBEDDING="passage: "

# cl-nagoya/ruri-v3-30m（日语专用、轻量）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=cl-nagoya/ruri-v3-30m
# EMBEDDING_DIM=256
# EMBEDDING_PREFIX_QUERY="検索クエリ: "
# EMBEDDING_PREFIX_EMBEDDING="検索文書: "

# ------------------------------------------------------------
# OpenAI 兼容 API 设置（仅在 EMBEDDING_PROVIDER=openai 时使用）
# ------------------------------------------------------------

# API 密钥
# - 使用官方 OpenAI 端点时必须
# - 将 EMBEDDING_BASE_URL 设置为非 OpenAI 主机时可省略
# EMBEDDING_API_KEY=sk-...

# 基础 URL
# - 未设置 或 https://api.openai.com/v1 → 官方端点（需要 API_KEY）
# - 其他 URL → 作为自托管服务处理，可省略 API_KEY
# - 格式：http(s)://hostname[:port]/path  ※ 格式错误的值会导致错误
# EMBEDDING_BASE_URL=http://localhost:9997/v1

# 批处理大小（一次 API 调用包含的最大文本数。默认：64）
# 如果遇到速率限制请减小此值
# EMBEDDING_API_BATCH_SIZE=64

# ------------------------------------------------------------
# OpenAI 兼容 API 设置示例
# ------------------------------------------------------------

# 官方 OpenAI / text-embedding-3-small（维度：1536）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_API_KEY=sk-...

# 官方 OpenAI / text-embedding-3-large（维度：3072）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
# EMBEDDING_API_KEY=sk-...

# 自托管 Xinference / bge-m3（维度：1024）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://localhost:9997/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# 自托管 Ollama / nomic-embed-text（维度：768）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# ============================================================
# 重排序（Reranker）设置
# ============================================================

# 提供者选择：none（默认）、local 或 openai
# - none  : 不使用重排序
# - local : 使用 CrossEncoder 本地推理（需要 sentence-transformers）
# - openai: 使用 OpenAI 兼容 rerank API（Jina / Cohere / 自托管等，需要 httpx）
RERANKER_PROVIDER=none

# 模型名称
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 候选取样倍数（先获取 limit × factor 个候选，再重排序取 top-k）
RERANK_FACTOR=3

# ------------------------------------------------------------
# OpenAI 兼容 rerank API 设置（仅在 RERANKER_PROVIDER=openai 时使用）
# ------------------------------------------------------------

# API 基础 URL（必填，如 https://api.jina.ai/v1）
# RERANKER_BASE_URL=https://api.jina.ai/v1

# API 密钥（部分服务可省略）
# RERANKER_API_KEY=jna_...

# Jina AI / jina-reranker-v2-base-multilingual
# RERANKER_PROVIDER=openai
# RERANKER_BASE_URL=https://api.jina.ai/v1
# RERANKER_MODEL=jina-reranker-v2-base-multilingual
# RERANKER_API_KEY=jna_...

# 自托管 Xinference / bge-reranker-v2-m3
# RERANKER_PROVIDER=openai
# RERANKER_BASE_URL=http://localhost:9997/v1
# RERANKER_MODEL=bge-reranker-v2-m3
