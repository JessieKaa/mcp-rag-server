# ============================================================
# PostgreSQL 接続情報
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ragdb

# ============================================================
# ドキュメントディレクトリ
# ============================================================
SOURCE_DIR=./data/source
PROCESSED_DIR=./data/processed

# ============================================================
# エンベディングモデル設定
# ============================================================

# プロバイダー選択: local（デフォルト）または openai
# - local  : sentence-transformers でローカル推論（追加インストール不要）
# - openai : OpenAI 互換 API（要: uv sync --extra openai）
EMBEDDING_PROVIDER=local

# モデル名（env の値が EmbeddingGenerator の引数より優先される）
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ベクトル次元数（モデルの出力次元に合わせること）
# モデル変更後は `python -m src.cli clear && python -m src.cli index` を実行すること
EMBEDDING_DIM=1024

# プレフィックス（E5 系・Ruri 系など専用モデルで有効。OpenAI モデルは通常空でよい）
EMBEDDING_PREFIX_QUERY="query: "
EMBEDDING_PREFIX_EMBEDDING="passage: "

# ------------------------------------------------------------
# ローカルモデル 設定例
# ------------------------------------------------------------

# intfloat/multilingual-e5-large（デフォルト、多言語対応）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_DIM=1024
# EMBEDDING_PREFIX_QUERY="query: "
# EMBEDDING_PREFIX_EMBEDDING="passage: "

# cl-nagoya/ruri-v3-30m（日本語特化・軽量）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=cl-nagoya/ruri-v3-30m
# EMBEDDING_DIM=256
# EMBEDDING_PREFIX_QUERY="検索クエリ: "
# EMBEDDING_PREFIX_EMBEDDING="検索文書: "

# ------------------------------------------------------------
# OpenAI 互換 API 設定（EMBEDDING_PROVIDER=openai 時のみ使用）
# ------------------------------------------------------------

# API キー
# - 公式 OpenAI エンドポイント使用時は必須
# - EMBEDDING_BASE_URL を非 OpenAI ホストに設定した場合は省略可能
# EMBEDDING_API_KEY=sk-...

# ベース URL
# - 未設定 または https://api.openai.com/v1 → 公式エンドポイント（API_KEY 必須）
# - その他の URL → 自ホストサービスとして扱い、API_KEY 省略可能
# - 形式: http(s)://hostname[:port]/path  ※ malformed な値はエラーになる
# EMBEDDING_BASE_URL=http://localhost:9997/v1

# バッチサイズ（1 回の API 呼び出しに含める最大テキスト数。デフォルト: 64）
# レート制限に引っかかる場合は小さくする
# EMBEDDING_API_BATCH_SIZE=64

# ------------------------------------------------------------
# OpenAI 互換 API 設定例
# ------------------------------------------------------------

# 公式 OpenAI / text-embedding-3-small（次元: 1536）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_API_KEY=sk-...

# 公式 OpenAI / text-embedding-3-large（次元: 3072）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
# EMBEDDING_API_KEY=sk-...

# 自ホスト Xinference / bge-m3（次元: 1024）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://localhost:9997/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# 自ホスト Ollama / nomic-embed-text（次元: 768）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
