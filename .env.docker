# ============================================================
# Docker Compose 用環境変数テンプレート
# .env.docker を .env にコピーして利用してください：
#   cp .env.docker .env
# ============================================================

# PostgreSQL — docker-compose のサービス名をホストに指定
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ragdb

# ドキュメントディレクトリ
SOURCE_DIR=./data/source
PROCESSED_DIR=./data/processed

# 埋め込みモデル設定
# local: sentence-transformers（Dockerfile / --profile local）
# openai: OpenAI 互換 API（Dockerfile.openai / --profile openai）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_PREFIX_QUERY=query:
EMBEDDING_PREFIX_EMBEDDING=passage:

# OpenAI 互換 API（EMBEDDING_PROVIDER=openai の場合）
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=http://localhost:9997/v1
# EMBEDDING_API_BATCH_SIZE=64

# 重排序（Reranker）设置
# none: 无效 / local: CrossEncoder 本地推理（--profile local）/ openai: OpenAI 兼容 API
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_FACTOR=3
# RERANKER_BASE_URL=https://api.jina.ai/v1
# RERANKER_API_KEY=jna_...
